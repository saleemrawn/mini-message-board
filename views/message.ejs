<html>
  <head>
    <title><%= page_title %></title>
  </head>
  <body>
    <main>
      <% message.forEach((msg) => { %>
        <div><%= msg.author %></div>
        <div><%= msg.message %></div>
        <div><%= msg.created_at %></div>
      <% }) %> 
      <a href="/">Back to home</a>
    </main>
  </body>
</html>
